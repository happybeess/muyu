{
  "name": "muyu-pet",
  "version": "1.0.0",
  "description": "摸鱼敲木鱼桌面宠物",
  "main": "main.js",
  "author": "happybeess",
  "scripts": {
    "start": "node start.js",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.muyu.pet",
    "productName": "摸鱼敲木鱼",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "start.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": null
    },
    "portable": {
      "artifactName": "摸鱼敲木鱼.exe"
    },
    "extraResources": []
  },
  "dependencies": {
    "uiohook-napi": "^1.5.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1"
  }
}
